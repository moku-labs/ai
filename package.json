{
  "name": "@moku-labs/ai",
  "version": "0.4.0",
  "description": "A build system for AI-generated assets — declarative build files in, artifacts out. Any task × any provider × any account pool. Resumable always, incremental by default, never loses a byte of progress.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "moku": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moku-labs/ai.git"
  },
  "homepage": "https://github.com/moku-labs/ai#readme",
  "bugs": {
    "url": "https://github.com/moku-labs/ai/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@moku-labs/common": "0.3.2",
    "@moku-labs/core": "1.6.0",
    "better-sqlite3": "12.11.1",
    "openai": "^6.45.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@arethetypeswrong/core": "0.18.3",
    "@biomejs/biome": "2.4.16",
    "@moku-labs/ci": "1.2.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.14",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint": "9.39.3",
    "eslint-config-biome": "2.1.3",
    "eslint-plugin-jsdoc": "62.6.0",
    "eslint-plugin-sonarjs": "4.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "lefthook": "2.1.1",
    "publint": "0.3.21",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "4.0.18"
  },
  "scripts": {
    "build": "tsdown",
    "validate": "publint && attw --pack . --profile node16",
    "lint": "biome check . && eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "release:setup": "moku-release setup",
    "release:doctor": "moku-release doctor",
    "release": "moku-release"
  }
}
